{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "update",
      "type": "npm",
      "script": "update",
      "problemMatcher": []
    },
    {
      "label": "l10n-export",
      "type": "npm",
      "script": "l10n:export",
      "problemMatcher": []
    },
    {
      "label": "watch",
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "problemMatcher": {
        "base": "$tsc-watch",
        "owner": "lslib-tools-watch",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(tsc|tsc-alias|copy-assets).*",
          "endsPattern": ".*(Found 0 errors|Watching for file changes).*"
        }
      },
      "presentation": {
        "reveal": "never"
      },
      "group": "build"
    },
    {
      "label": "prepare",
      "dependsOn": ["update", "l10n-export"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "update-and-watch",
      "dependsOn": ["prepare", "watch"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}

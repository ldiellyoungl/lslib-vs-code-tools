{
  "contributes": {
    "configuration": [
      {
        "title": "Viewers",
        "order": 10,
        "properties": {
          "viewers.pak.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Enable `.pak` file viewing",
            "order": 0
          },
          "viewers.gr2.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Enable `.gr2` viewing",
            "order": 0
          }
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "lslib.pak",
        "displayName": "LSLib PAK Viewer",
        "selector": [{ "filenamePattern": "*.pak" }],
        "priority": "default"
      },
      {
        "viewType": "lslib.gr2",
        "displayName": "LSLib GR2 viewer",
        "selector": [{ "filenamePattern": "*.gr2" }],
        "priority": "default"
      },
      {
        "viewType": "lslib.lsfxViewer",
        "displayName": "LSLib LSFX/LSF Editor",
        "selector": [
          { "filenamePattern": "*.lsfx" },
          { "filenamePattern": "*.lsf" },
          { "filenamePattern": "*.lsb" },
          { "filenamePattern": "*.loca" }
        ],
        "priority": "default"
      }
    ]
  }
}

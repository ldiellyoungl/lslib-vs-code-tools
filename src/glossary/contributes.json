{
  "contributes": {
    "configuration": [
      {
        "title": "Glossary",
        "order": 4,
        "properties": {
          "glossary.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable glossary (decorators and hover providers).",
            "order": 0
          },
          "glossary.searchFolders": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": ["Localization"],
            "markdownDescription": "List of folders in which terms are searched for.\n\\Example:`Localization`,`Scripts`",
            "order": 1
          }
        }
      }
    ],
    "commands": [
      {
        "command": "glossary.init",
        "title": "Glossary: Initialize",
        "icon": "new-folder",
        "category": "Glossary"
      },
      {
        "command": "glossary.termin.add",
        "title": "Glossary: Add termin",
        "icon": "add",
        "category": "Glossary",
        "enablement": "config.glossary.enabled"
      },
      {
        "command": "glossary.termin.show",
        "title": "Glossary: Show termin",
        "icon": "$(eye)",
        "category": "Glossary",
        "enablement": "config.glossary.enabled"
      },
      {
        "command": "glossary.termin.alias.add",
        "title": "Glossary: Add alias",
        "icon": "add",
        "category": "Glossary",
        "enablement": "config.glossary.enabled"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "glossary.init",
          "when": "explorerResourceIsFolder",
          "group": "z_lslib@1"
        }
      ],
      "editor/context": [
        {
          "command": "glossary.termin.add",
          "group": "z_lslib@3"
        },
        {
          "command": "glossary.termin.alias.add",
          "group": "z_lslib@4"
        }
      ]
    },
    "jsonValidation": [
      {
        "url": "./src/glossary/schema.json",
        "fileMatch": ".glossary/*.json"
      }
    ]
  }
}

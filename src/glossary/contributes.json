{
  "contributes": {
    "configuration": [
      {
        "title": "Глоссарий",
        "properties": {
          "glossary.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Включить глоссарий (подсветку терминов и подсказки при наведении мыши).",
            "order": 0
          },
          "glossary.searchFolders": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": ["Localization"],
            "description": "Список папок, в которых ищутся термины глоссария (например, ['Localization', 'Scripts']).",
            "order": 1
          }
        }
      }
    ],
    "commands": [
      {
        "command": "glossary.init",
        "title": "Глоссарий: Инициализировать",
        "icon": "new-folder",
        "category": "Глоссарий"
      },
      {
        "command": "glossary.termin.add",
        "title": "Глоссарий: Добавить термин",
        "icon": "add",
        "category": "Глоссарий",
        "enablement": "config.glossary.enabled"
      },
      {
        "command": "glossary.termin.show",
        "title": "Глоссарий: показать термин",
        "icon": "$(eye)",
        "category": "Глоссарий",
        "enablement": "config.glossary.enabled"
      },
      {
        "command": "glossary.termin.alias.add",
        "title": "Глоссарий: Добавить аллиас",
        "icon": "add",
        "category": "Глоссарий",
        "enablement": "config.glossary.enabled"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "glossary.init",
          "when": "explorerResourceIsFolder",
          "group": "z_lslib@1"
        }
      ],
      "editor/context": [
        {
          "command": "glossary.termin.add",
          "group": "z_lslib@3"
        },
        {
          "command": "glossary.termin.alias.add",
          "group": "z_lslib@4"
        }
      ]
    },
    "jsonValidation": [
      {
        "url": "./src/glossary/schema.json",
        "fileMatch": ".glossary/*.json"
      }
    ]
  }
}

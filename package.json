{
  "name": "lslib-tools",
  "displayName": "LSLib Tools",
  "description": "Набор инструментов для моддинга игр от Larian Studios прямо в VS Code",
  "publisher": "LeoBlock",
  "version": "2.1.1",
  "categories": [
    "Other"
  ],
  "icon": "src/resources/icons/icon.png",
  "galleryBanner": {
    "color": "#31344e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ldiellyoungl/lslib-vs-code-tools"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.70.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": [
      {
        "title": "Divine CLI: Аргументы",
        "order": 0,
        "properties": {
          "divineCli.game": {
            "type": "string",
            "default": "bg3",
            "enum": [
              "dos",
              "dosee",
              "dos2",
              "dos2de",
              "bg3"
            ],
            "enumDescriptions": [
              "Divinity: Original Sin",
              "Divinity: Original Sin - Enhanced Edition",
              "Divinity: Original Sin 2",
              "Divinity: Original Sin 2 - Definitive Edition",
              "Baldur's Gate 3"
            ],
            "description": "Целевая игра для операций Divine CLI"
          },
          "divineCli.compressionMethod": {
            "type": "string",
            "default": "lz4",
            "enum": [
              "zlib",
              "zlibfast",
              "lz4",
              "lz4hc",
              "none"
            ],
            "description": "Метод сжатия по умолочанию при создании PAK"
          },
          "divineCli.logLevel": {
            "type": "string",
            "default": "info",
            "enum": [
              "off",
              "fatal",
              "error",
              "warn",
              "info",
              "debug",
              "trace",
              "all"
            ],
            "description": "Уровень детализации логов Divine CLI"
          }
        }
      },
      {
        "title": "Meta.lsx: Диагностика",
        "order": 1,
        "properties": {
          "metalsx.diagnostics.enable": {
            "type": "boolean",
            "default": true,
            "description": "Включить диагностику"
          }
        }
      },
      {
        "title": "Meta.lsx: Codelens",
        "order": 2,
        "properties": {
          "metalsx.codelens.moduleInfo.enable": {
            "type": "boolean",
            "default": true,
            "description": "Включить быстрые действия над блоком ModuleInfo"
          },
          "metalsx.codelens.uuid.enable": {
            "type": "boolean",
            "default": true,
            "description": "Включить быстрые действия над строкой UUID"
          },
          "metalsx.codelens.version.enable": {
            "type": "boolean",
            "default": true,
            "description": "Включить быстрые действия над строкой Version64"
          }
        }
      },
      {
        "title": "Meta.lsx: Прочее",
        "order": 3,
        "properties": {
          "metalsx.inlayhints.version.enable": {
            "type": "boolean",
            "default": true,
            "description": "Включить показ дешефрованной версии"
          },
          "metalsx.hovers.enable": {
            "type": "boolean",
            "default": true,
            "description": "Включить подсказки при наведении мыши"
          }
        }
      },
      {
        "title": "Глоссарий: Общее",
        "order": 4,
        "properties": {
          "glossary.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Включить  поддержку глоссария (подсветку терминов и подсказки при наведении мыши)."
          },
          "glossary.searchFolders": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "Localization"
            ],
            "description": "Список папок, в которых ищутся термины глоссария (например, ['Localization', 'Scripts'])."
          }
        }
      },
      {
        "title": "Работа с локализацией",
        "properties": {
          "localization.decorators.enable": {
            "type": "boolean",
            "default": true,
            "description": "Включить декораторы локализации"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "divineCli.extractPak",
        "title": "DivineCLI: Распаковать PAK",
        "category": "DivineCLI"
      },
      {
        "command": "divineCli.createPak",
        "title": "DivineCLI: Создать PAK",
        "category": "DivineCLI"
      },
      {
        "command": "divineCli.convert-resource",
        "title": "DivineCLI: Конвертировать ресурс",
        "category": "DivineCLI"
      },
      {
        "command": "divineCli.convert-loca",
        "title": "DivineCLI: Конвертировать локализацию",
        "category": "DivineCLI"
      },
      {
        "command": "metalsx.copyAsShortDesc",
        "title": "Скопировать как ModuleShortDesc",
        "category": "Meta.lsx",
        "enablement": "metalsx.codelens.moduleInfo.enable"
      },
      {
        "command": "metalsx.insertAsDependency",
        "title": "Вставить как ModuleShortDesc в зависимости",
        "category": "Meta.lsx",
        "enablement": "metalsx.codelens.moduleInfo.enable"
      },
      {
        "command": "metalsx.insertAsConflict",
        "title": "Вставить как ModuleShortDesc в конфликты",
        "category": "Meta.lsx",
        "enablement": "metalsx.codelens.moduleInfo.enable"
      },
      {
        "command": "glossary.init",
        "title": "Инициализировать",
        "category": "Глоссарий"
      },
      {
        "command": "glossary.showTerm",
        "title": "Показать термин",
        "category": "Глоссарий",
        "enablement": "config.glossary.enabled"
      },
      {
        "command": "glossary.addTermin",
        "title": "Добавить термин",
        "category": "Глоссарий",
        "enablement": "config.glossary.enabled"
      },
      {
        "command": "metalsx.editVersion64",
        "title": "Редактировать версию",
        "category": "Общее"
      },
      {
        "command": "metalsx.generateUuid",
        "title": "Сгенерировать и вставить UUID",
        "category": "Общее"
      },
      {
        "command": "localization.goToTranslation",
        "title": "Перейти к локализации",
        "category": "Локализация",
        "enablement": "config.decorators.enabled"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "divineCli.extractPak",
          "when": "resourceExtname == .pak",
          "group": "z_lslib@1"
        },
        {
          "command": "divineCli.createPak",
          "when": "explorerResourceIsFolder == true",
          "group": "z_lslib@2"
        },
        {
          "command": "divineCli.convert-resource",
          "when": "resourceExtname == '.lsf' || resourceExtname == '.lsfx' || resourceExtname == '.lsb' || resourceExtname == '.lsj' || resourceExtname == '.lsx'",
          "group": "z_lslib@3"
        },
        {
          "command": "divineCli.convert-loca",
          "when": "resourceExtname == '.loca' || resourceExtname == '.xml'",
          "group": "z_lslib@4"
        },
        {
          "command": "glossary.init",
          "when": "explorerResourceIsFolder",
          "group": "z_lslib@5"
        }
      ],
      "editor/context": [
        {
          "command": "metalsx.generateUuid",
          "group": "z_lslib@1"
        },
        {
          "command": "metalsx.editVersion64",
          "group": "z_lslib@2"
        },
        {
          "command": "glossary.addTermin",
          "group": "z_lslib@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./ && tsc-alias -p ./tsconfig.json && node scripts/copy-assets.js",
    "watch": "concurrently \"tsc -watch -p ./\" \"tsc-alias -w -p ./tsconfig.json\" \"node scripts/copy-assets.js --watch\"",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "update": "vscode-ext-gen --output src/generated/meta.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/sax": "^1.2.7",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "concurrently": "^10.0.6",
    "copyfiles": "^2.4.1",
    "eslint": "^10.5.0",
    "tsc-alias": "^1.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vscode-ext-gen": "^1.6.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "sax": "^1.6.1"
  }
}

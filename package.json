{
  "name": "lslib-tools",
  "displayName": "LSLib Tools",
  "description": "Набор инструментов для моддинга игр от Larian Studios прямо в VS Code",
  "publisher": "LeoBlock",
  "version": "2.1.4",
  "categories": [
    "Other"
  ],
  "icon": "src/resources/icons/icon.png",
  "galleryBanner": {
    "color": "#31344e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ldiellyoungl/lslib-vs-code-tools"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.140.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./ && tsc-alias -p ./tsconfig.json && node scripts/copy-assets.js",
    "watch": "concurrently \"tsc -watch -p ./\" \"tsc-alias -w -p ./tsconfig.json\" \"node scripts/copy-assets.js --watch\"",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "update": "vscd --clean && vscode-ext-gen --output src/generated/meta.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/sax": "^1.2.7",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "concurrently": "^10.0.6",
    "copyfiles": "^2.4.1",
    "eslint": "^10.5.0",
    "tsc-alias": "^1.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vscd": "^1.1.0",
    "vscode-ext-gen": "^1.6.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "sax": "^1.6.1"
  },
  "extensionDependencies": [
    "mikeburgh.xml-format"
  ],
  "contributes": {
    "configuration": [
      {
        "title": "Meta.lsx: Общее",
        "properties": {
          "metalsx.diagnostics.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Включить диагностику"
          },
          "metalsx.inlayhints.version.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Включить показ декодированной версии"
          }
        }
      },
      {
        "title": "Meta.lsx: Быстрые действия",
        "properties": {
          "metalsx.codelens.moduleInfo.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Включить быстрые действия над блоком ModuleInfo"
          },
          "metalsx.codelens.uuid.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Включить быстрые действия над строкой UUID"
          },
          "metalsx.codelens.version.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Включить быстрые действия над строкой Version64"
          }
        }
      },
      {
        "title": "Локализация",
        "properties": {
          "localization.decorators.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Включить декораторы локализации"
          }
        }
      },
      {
        "title": "Глоссарий",
        "properties": {
          "glossary.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Включить поддержку глоссария (подсветку терминов и подсказки при наведении мыши)."
          },
          "glossary.searchFolders": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "Localization"
            ],
            "description": "Список папок, в которых ищутся термины глоссария (например, ['Localization', 'Scripts'])."
          }
        }
      },
      {
        "title": "Divine CLI: Аргументы",
        "properties": {
          "divineCli.args.game": {
            "type": "string",
            "default": "bg3",
            "enum": [
              "dos",
              "dosee",
              "dos2",
              "dos2de",
              "bg3"
            ],
            "enumDescriptions": [
              "Divinity: Original Sin",
              "Divinity: Original Sin - Enhanced Edition",
              "Divinity: Original Sin 2",
              "Divinity: Original Sin 2 - Definitive Edition",
              "Baldur's Gate 3"
            ],
            "description": "Целевая игра для операций Divine CLI"
          },
          "divineCli.args.compressionMethod": {
            "type": "string",
            "default": "lz4",
            "enum": [
              "zlib",
              "zlibfast",
              "lz4",
              "lz4hc",
              "none"
            ],
            "description": "Метод сжатия по умолочанию при создании PAK"
          },
          "divineCli.args.logLevel": {
            "type": "string",
            "default": "info",
            "enum": [
              "off",
              "fatal",
              "error",
              "warn",
              "info",
              "debug",
              "trace",
              "all"
            ],
            "description": "Уровень детализации логов Divine CLI"
          }
        }
      },
      {
        "title": "Общее",
        "properties": {
          "resources.documentLink.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Включить ссылки для ресурсных путей"
          }
        }
      }
    ],
    "commands": [
      {
        "title": "Скопировать ModuleInfo как ModuleShortDesc",
        "command": "metalsx.codelens.copyAsShortDesc",
        "category": "Meta.lsx"
      },
      {
        "title": "Преобразовать ModuleInfo как ModuleShortDesc и вставить в зависимости",
        "command": "metalsx.codelens.insertAsDependency",
        "category": "Meta.lsx"
      },
      {
        "title": "Преобразовать ModuleInfo как ModuleShortDesc и вставить в конфликты",
        "command": "metalsx.codelens.insertAsConflict",
        "category": "Meta.lsx"
      },
      {
        "title": "Отредактировать версию",
        "command": "metalsx.codelens.editVersion64",
        "category": "Meta.lsx"
      },
      {
        "title": "Сгенерировать UUID",
        "command": "metalsx.codelens.generateUUID",
        "category": "Meta.lsx"
      },
      {
        "command": "localization.goToTranslation",
        "title": "Перейти к локализации",
        "category": "Локализация",
        "enablement": "config.localization.decorators.enabled"
      },
      {
        "command": "glossary.init",
        "title": "Глоссарий: Инициализировать",
        "category": "Глоссарий"
      },
      {
        "command": "glossary.addTermin",
        "title": "Глоссарий: Добавить термин",
        "category": "Глоссарий",
        "enablement": "config.glossary.enabled"
      },
      {
        "command": "glossary.addAlias",
        "title": "Глоссарий: Добавить аллиас",
        "category": "Глоссарий",
        "enablement": "config.glossary.enabled"
      },
      {
        "command": "divineCli.extractPak",
        "title": "DivineCLI: Распаковать PAK",
        "category": "DivineCLI"
      },
      {
        "command": "divineCli.createPak",
        "title": "DivineCLI: Создать PAK",
        "category": "DivineCLI"
      },
      {
        "command": "divineCli.convert-resource",
        "title": "DivineCLI: Конвертировать ресурс",
        "category": "DivineCLI"
      },
      {
        "command": "divineCli.convert-loca",
        "title": "DivineCLI: Конвертировать локализацию",
        "category": "DivineCLI"
      },
      {
        "title": "Вставить версию в формате int64",
        "command": "common.editor.context.insertVersion64",
        "icon": "$(add-compact)"
      },
      {
        "title": "Сгенерировать и вставить UUID",
        "command": "common.editor.context.insertUUID",
        "icon": "$(add-compact)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "glossary.init",
          "when": "explorerResourceIsFolder",
          "group": "z_lslib@5"
        },
        {
          "command": "divineCli.extractPak",
          "when": "resourceExtname == .pak",
          "group": "z_lslib@1"
        },
        {
          "command": "divineCli.createPak",
          "when": "explorerResourceIsFolder == true",
          "group": "z_lslib@2"
        },
        {
          "command": "divineCli.convert-resource",
          "when": "resourceExtname == '.lsf' || resourceExtname == '.lsfx' || resourceExtname == '.lsb' || resourceExtname == '.lsj' || resourceExtname == '.lsx' || resourceExtname == '.gr2'",
          "group": "z_lslib@3"
        },
        {
          "command": "divineCli.convert-loca",
          "when": "resourceExtname == '.loca' || resourceExtname == '.xml'",
          "group": "z_lslib@4"
        }
      ],
      "editor/context": [
        {
          "command": "glossary.addTermin"
        },
        {
          "command": "glossary.addAlias"
        },
        {
          "command": "common.editor.context.insertVersion64"
        },
        {
          "command": "common.editor.context.insertUUID"
        }
      ]
    }
  }
}
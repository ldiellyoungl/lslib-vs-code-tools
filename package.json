{
  "name": "lslib-tools",
  "displayName": "LSLib Tools",
  "description": "Набор инструментов для моддинга Baldur's Gate 3 и Divinity: Original Sin 2 прямо в VS Code",
  "publisher": "LeoBlock",
  "version": "1.5.1",
  "categories": [
    "Other"
  ],
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#31344e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ldiellyoungl/lslib-vs-code-tools"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.70.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "LSLib Tools",
      "properties": {
        "lslib.game": {
          "type": "string",
          "default": "bg3",
          "enum": [
            "bg3",
            "dos2",
            "dos2ee",
            "dos"
          ],
          "enumDescriptions": [
            "Baldur's Gate 3",
            "Divinity: Original Sin 2 (Definitive Edition)",
            "Divinity: Original Sin 2 (Early Access)",
            "Divinity: Original Sin (Enhanced Edition)"
          ],
          "description": "Игра, для которой выполняются операции с файлами"
        }
      }
    },
    "commands": [
      {
        "command": "LSLib.unpackPak",
        "title": "📦LSLib: Распаковать PAK",
        "icon": "$(unarchive)"
      },
      {
        "command": "LSLib.packFolder",
        "title": "📦LSLib: Запаковать папку в PAK",
        "icon": "$(archive)"
      },
      {
        "command": "LSLib.convertResource",
        "title": "🔄LSLib: Конвертировать ресурс (LSF/LSX/LSJ/LSB)",
        "icon": "$(symbol-enum)"
      },
      {
        "command": "LSLib.convertLoca",
        "title": "🌍LSLib: Конвертировать локализацию (LOCA/XML)",
        "icon": "$(globe)"
      },
      {
        "command": "LSLib.generateUUID",
        "title": "🆔LSLib: Сгенерировать UUID",
        "icon": "$(key)"
      },
      {
        "command": "LSLib.encodeVersion",
        "title": "🔢LSLib: Версия",
        "icon": "$(symbol-number)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "LSLib.unpackPak",
          "when": "resourceExtname == .pak",
          "group": "LSLib@1"
        },
        {
          "command": "LSLib.packFolder",
          "when": "explorerResourceIsFolder",
          "group": "LSLib@2"
        },
        {
          "command": "LSLib.convertResource",
          "when": "resourceExtname == .lsf || resourceExtname == .lsx || resourceExtname == .lsj || resourceExtname == .lsb",
          "group": "LSLib@3"
        },
        {
          "command": "LSLib.convertLoca",
          "when": "resourceExtname == .loca || resourceExtname == .locas || resourceExtname == .xml",
          "group": "LSLib@4"
        }
      ],
      "editor/context": [
        {
          "command": "LSLib.generateUUID",
          "group": "LSLib@1"
        },
        {
          "command": "LSLib.encodeVersion",
          "group": "LSLib@2"
        }
      ]
    }
  }
}

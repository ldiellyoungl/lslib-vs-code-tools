{
  "name": "lslib-tools",
  "displayName": "LSLib Tools",
  "description": "Набор инструментов для моддинга игр от Larian Studios прямо в VS Code",
  "publisher": "LeoBlock",
  "version": "2.1.6",
  "categories": [
    "Other"
  ],
  "icon": "src/resources/icons/icon.png",
  "galleryBanner": {
    "color": "#31344e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ldiellyoungl/lslib-vs-code-tools"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.140.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./ && tsc-alias -p ./tsconfig.json && node scripts/copy-assets.js",
    "watch": "concurrently \"tsc -watch -p ./\" \"tsc-alias -w -p ./tsconfig.json\" \"node scripts/copy-assets.js --watch\"",
    "update": "vscd --clean && vscode-ext-gen --output src/generated/meta.ts",
    "l10n:export": "npx @vscode/l10n-dev export -o ./l10n ./src"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "~24.19.2",
    "@types/sax": "^1.2.7",
    "@types/vscode": "^1.145.0",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "concurrently": "^10.0.7",
    "copyfiles": "^2.4.1",
    "eslint": "^10.14.0",
    "tsc-alias": "^1.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vscd": "^1.1.0",
    "vscode-ext-gen": "^1.6.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "sax": "^1.6.1"
  },
  "extensionDependencies": [
    "mikeburgh.xml-format"
  ],
  "contributes": {
    "configuration": [
      {
        "title": "Meta.lsx",
        "order": 1,
        "properties": {
          "metalsx.diagnostics.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable diagnostics",
            "order": 0
          },
          "metalsx.inlayhints.version.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable display of the decoded version",
            "order": 1
          },
          "metalsx.codelens.moduleInfo.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Enable quick actions for `<node id=\"ModuleInfo\">`\n\nCodelens: `copyAsShortDesc`, `insertAsDependency` and `insertAsConflict`",
            "order": 2
          },
          "metalsx.codelens.version.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Enable quick actions for `<attribute id=\"Version64\".../>`\n\nCodelens: `editVersion64`",
            "order": 3
          },
          "metalsx.codelens.uuid.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Enable quick actions for `<attribute id=\"UUID\".../>`\n\nCodelens:`generateUUID`",
            "order": 4
          }
        }
      },
      {
        "title": "Localization",
        "order": 2,
        "properties": {
          "localization.decorators.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Enable decorators. \n\n*Show translated string next to handles*",
            "order": 0
          },
          "localization.decorators.handles.blacklist": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "ls::TranslatedStringRepository::s_HandleUnknown"
            ],
            "markdownDescription": "List of handles to be ignored. \n\n*Example: `ls::TranslatedStringRepository::s_HandleUnknown`*",
            "order": 1
          }
        }
      },
      {
        "title": "Glossary",
        "order": 4,
        "properties": {
          "glossary.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable glossary (decorators and hover providers).",
            "order": 0
          },
          "glossary.searchFolders": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "Localization"
            ],
            "markdownDescription": "List of folders in which terms are searched for.\n\\Example:`Localization`,`Scripts`",
            "order": 1
          }
        }
      },
      {
        "title": "Viewers",
        "order": 10,
        "properties": {
          "viewers.pak.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Enable `.pak` file viewing",
            "order": 0
          },
          "viewers.gr2.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Enable `.gr2` viewing",
            "order": 0
          }
        }
      },
      {
        "title": "Divine CLI",
        "order": 0,
        "properties": {
          "divineCli.args.game": {
            "type": "string",
            "default": "bg3",
            "enum": [
              "dos",
              "dosee",
              "dos2",
              "dos2de",
              "bg3"
            ],
            "enumDescriptions": [
              "Divinity: Original Sin",
              "Divinity: Original Sin - Enhanced Edition",
              "Divinity: Original Sin 2",
              "Divinity: Original Sin 2 - Definitive Edition",
              "Baldur's Gate 3"
            ],
            "markdownDescription": "Target game for Divine CLI operations\n\n*[Documentation](https://github.com/Norbyte/lslib/blob/master/Divine/CLI/CommandLineArguments.cs#L25)*",
            "order": 0
          },
          "divineCli.args.compressionMethod": {
            "type": "string",
            "default": "lz4",
            "enum": [
              "zlib",
              "zlibfast",
              "lz4",
              "lz4hc",
              "none"
            ],
            "markdownDescription": "Default compression method when creating a `.pak`\n\n*[Documentation](https://github.com/Norbyte/lslib/blob/master/Divine/CLI/CommandLineArguments.cs#L92)*",
            "order": 1
          },
          "divineCli.args.logLevel": {
            "type": "string",
            "default": "info",
            "enum": [
              "off",
              "fatal",
              "error",
              "warn",
              "info",
              "debug",
              "trace",
              "all"
            ],
            "markdownDescription": "Log detail level\n\n*[Documentation](https://github.com/Norbyte/lslib/blob/master/Divine/CLI/CommandLineArguments.cs#L15)*",
            "order": 2
          }
        }
      },
      {
        "title": "Resources",
        "order": 3,
        "properties": {
          "resources.documentLink.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable links for resource paths",
            "order": 0
          }
        }
      }
    ],
    "commands": [
      {
        "title": "Copy ModuleInfo as ModuleShortDesc",
        "command": "metalsx.codelens.copyAsShortDesc",
        "icon": "$(copy)",
        "category": "Meta.lsx",
        "enablement": "config.metalsx.codelens.moduleInfo.enabled"
      },
      {
        "title": "Insert as a dependency",
        "command": "metalsx.codelens.insertAsDependency",
        "icon": "$(clippy)",
        "category": "Meta.lsx",
        "enablement": "config.metalsx.codelens.moduleInfo.enabled"
      },
      {
        "title": "Insert as a conflict",
        "command": "metalsx.codelens.insertAsConflict",
        "icon": "$(clippy)",
        "category": "Meta.lsx",
        "enablement": "config.metalsx.codelens.moduleInfo.enabled"
      },
      {
        "title": "Edit",
        "command": "metalsx.codelens.editVersion64",
        "icon": "$(edit)",
        "category": "Meta.lsx",
        "enablement": "config.metalsx.codelens.version.enabled"
      },
      {
        "title": "Generate new",
        "command": "metalsx.codelens.generateUUID",
        "icon": "$(refresh)",
        "category": "Meta.lsx",
        "enablement": "config.metalsx.codelens.uuid.enabled"
      },
      {
        "command": "localization.goToTranslation",
        "title": "Go to translation",
        "icon": "$(go-to-file)",
        "category": "Локализация",
        "enablement": "config.localization.decorators.enabled"
      },
      {
        "command": "glossary.init",
        "title": "Glossary: Initialize",
        "icon": "new-folder",
        "category": "Glossary"
      },
      {
        "command": "glossary.termin.add",
        "title": "Glossary: Add termin",
        "icon": "add",
        "category": "Glossary",
        "enablement": "config.glossary.enabled"
      },
      {
        "command": "glossary.termin.show",
        "title": "Glossary: Show termin",
        "icon": "$(eye)",
        "category": "Glossary",
        "enablement": "config.glossary.enabled"
      },
      {
        "command": "glossary.termin.alias.add",
        "title": "Glossary: Add alias",
        "icon": "add",
        "category": "Glossary",
        "enablement": "config.glossary.enabled"
      },
      {
        "command": "divineCli.extractPak",
        "title": "Extract .pak",
        "icon": "$(unarchive)",
        "category": "DivineCLI"
      },
      {
        "command": "divineCli.createPak",
        "title": "Create .pak",
        "icon": "$(archive)",
        "category": "DivineCLI"
      },
      {
        "command": "divineCli.convert-resource",
        "title": "Convert resource(s)",
        "icon": "$(sync)",
        "category": "DivineCLI"
      },
      {
        "command": "divineCli.convert-loca",
        "title": "Convert localization(s)",
        "icon": "$(sync)",
        "category": "DivineCLI"
      },
      {
        "title": "Insert version in int64 format",
        "command": "common.editor.context.insertVersion64",
        "icon": "$(add)",
        "category": "Общее"
      },
      {
        "title": "Generate and insert UUID",
        "command": "common.editor.context.insertUUID",
        "icon": "$(add)",
        "category": "Общее"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "glossary.init",
          "when": "explorerResourceIsFolder",
          "group": "z_lslib@1"
        },
        {
          "command": "divineCli.extractPak",
          "when": "resourceExtname == .pak",
          "group": "z_lslib@1"
        },
        {
          "command": "divineCli.createPak",
          "when": "explorerResourceIsFolder == true",
          "group": "z_lslib@2"
        },
        {
          "command": "divineCli.convert-resource",
          "when": "resourceExtname == '.lsf' || resourceExtname == '.lsfx' || resourceExtname == '.lsb' || resourceExtname == '.lsj' || resourceExtname == '.lsx'",
          "group": "z_lslib@3"
        },
        {
          "command": "divineCli.convert-loca",
          "when": "resourceExtname == '.loca' || resourceExtname == '.xml'",
          "group": "z_lslib@4"
        }
      ],
      "editor/context": [
        {
          "command": "glossary.termin.add",
          "group": "z_lslib@3"
        },
        {
          "command": "glossary.termin.alias.add",
          "group": "z_lslib@4"
        },
        {
          "command": "common.editor.context.insertVersion64",
          "group": "z_lslib@1"
        },
        {
          "command": "common.editor.context.insertUUID",
          "group": "z_lslib@2"
        }
      ]
    },
    "jsonValidation": [
      {
        "url": "./src/glossary/schema.json",
        "fileMatch": ".glossary/*.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "lslib.pak",
        "displayName": "LSLib PAK Viewer",
        "selector": [
          {
            "filenamePattern": "*.pak"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "lslib.gr2",
        "displayName": "LSLib GR2 viewer",
        "selector": [
          {
            "filenamePattern": "*.gr2"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "lslib.lsfxViewer",
        "displayName": "LSLib LSFX/LSF Editor",
        "selector": [
          {
            "filenamePattern": "*.lsfx"
          },
          {
            "filenamePattern": "*.lsf"
          },
          {
            "filenamePattern": "*.lsb"
          },
          {
            "filenamePattern": "*.loca"
          }
        ],
        "priority": "default"
      }
    ]
  }
}
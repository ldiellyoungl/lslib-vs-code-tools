{
  "name": "LSLib-tools",
  "displayName": "LSLib tools",
  "description": "Инструменты LSLib прямо в контекстном меню",
  "publisher": "LeoBlock",
  "version": "1.0.3",
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ldiellyoungl/lslib-vs-code-tools"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.70.0"
  },
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "LSLib.unpackPak",
        "title": "LSLib: Распаковать PAK",
        "icon": "$(unarchive)"
      },
      {
        "command": "LSLib.packFolder",
        "title": "LSLib: Запаковать в PAK",
        "icon": "$(archive)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "LSLib.unpackPak",
          "when": "resourceExtname == .pak",
          "group": "LSLib@1"
        },
        {
          "command": "LSLib.packFolder",
          "when": "explorerResourceIsFolder",
          "group": "LSLib@2"
        }
      ]
    }
  }
}
